rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function bootstrapAdmin() {
      return signedIn()
        && request.auth.token.email in ['lgs7942@naver.com', 'lgs79422@gmail.com'];
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return bootstrapAdmin()
        || (hasUserDoc() && myUser().data.active != false);
    }

    function isAdmin() {
      return bootstrapAdmin() || (hasUserDoc() && myUser().data.role == 'admin');
    }

    function isManagerOrAdmin() {
      return isAdmin() || (hasUserDoc() && myUser().data.role == 'manager');
    }

    function mesKeyIsAudit(key) {
      return key == 'auditLog';
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if isActiveUser() && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /roles/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /popbill_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /audit_logs/{docId} {
      allow create: if isActiveUser();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /mes_v2/{key} {
      allow read: if isActiveUser() && (!mesKeyIsAudit(key) || isAdmin());
      allow create, update: if isActiveUser();
      allow delete: if isManagerOrAdmin();

      match /items/{itemId} {
        allow read: if isActiveUser() && (!mesKeyIsAudit(key) || isAdmin());
        allow create, update: if isActiveUser();
        allow delete: if isManagerOrAdmin();
      }

      match /state/{stateId} {
        allow read: if isActiveUser() && (!mesKeyIsAudit(key) || isAdmin());
        allow create, update: if isActiveUser();
        allow delete: if isManagerOrAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
